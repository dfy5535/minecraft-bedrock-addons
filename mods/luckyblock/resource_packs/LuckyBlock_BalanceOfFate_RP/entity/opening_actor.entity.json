{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "lucky:opening_actor",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/opening_actor"
      },
      "geometry": {
        "default": "geometry.lucky_opening_actor"
      },
      "animations": {
        "idle": "animation.lucky_opening.idle",
        "spin_ascend": "animation.lucky_opening.spin_ascend",
        "pulse": "animation.lucky_opening.pulse",
        "burst": "animation.lucky_opening.burst",
        "reveal_good": "animation.lucky_opening.reveal_good",
        "reveal_bad": "animation.lucky_opening.reveal_bad"
      },
      "scripts": {
        "animate": [
          {
            "idle": "q.property('lucky:phase') == 0"
          },
          {
            "spin_ascend": "q.property('lucky:phase') == 1"
          },
          {
            "pulse": "q.property('lucky:phase') == 2"
          },
          {
            "burst": "q.property('lucky:phase') == 3"
          },
          {
            "reveal_good": "q.property('lucky:phase') == 4"
          },
          {
            "reveal_bad": "q.property('lucky:phase') == 5"
          }
        ]
      },
      "render_controllers": [
        "controller.render.lucky_opening_actor"
      ]
    }
  }
}