{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": { "identifier": "lucky:wild_seed", "population_control": "ambient" },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:weight": { "default": 6 },
        "minecraft:density_limit": { "surface": 1 },
        "minecraft:distance_filter": { "min": 32, "max": 96 },
        "minecraft:biome_filter": [
          { "any_of": [
            { "test": "has_biome_tag", "operator": "==", "value": "overworld" },
            { "test": "has_biome_tag", "operator": "==", "value": "nether" },
            { "test": "has_biome_tag", "operator": "==", "value": "the_end" },
            { "test": "has_biome_tag", "operator": "==", "value": "ocean" }
          ]}
        ]
      }
    ]
  }
}
