# ============================================================================
# lg_boot —— 自举：安装后无需手动执行任何命令
# 原理：用一个永不消失的隐形哨兵实体判断"是否初始化过"
#       （不能用计分板判断——判断计分板是否存在本身就要用计分板，鸡生蛋）
# ============================================================================
execute unless entity @e[type=armor_stand,name="LG_Boot"] run function lg/init
