{
 "format_version": "1.10.0",
 "animation_controllers": {
  "controller.animation.bt.guardian": {
   "initial_state": "idle",
   "states": {
    "idle": {
     "animations": [
      "idle"
     ],
     "transitions": [
      {
       "walk": "query.modified_move_speed > 0.05"
      },
      {
       "attack": "query.is_delayed_attacking"
      },
      {
       "special": "query.mark_variant == 2"
      }
     ]
    },
    "walk": {
     "animations": [
      "walk"
     ],
     "transitions": [
      {
       "idle": "query.modified_move_speed <= 0.05"
      },
      {
       "attack": "query.is_delayed_attacking"
      },
      {
       "special": "query.mark_variant == 2"
      }
     ]
    },
    "attack": {
     "animations": [
      "attack"
     ],
     "transitions": [
      {
       "idle": "!query.is_delayed_attacking && query.modified_move_speed <= 0.05"
      },
      {
       "walk": "!query.is_delayed_attacking && query.modified_move_speed > 0.05"
      },
      {
       "special": "query.mark_variant == 2"
      }
     ]
    },
    "special": {
     "animations": [
      "special"
     ],
     "transitions": [
      {
       "idle": "query.mark_variant != 2 && query.modified_move_speed <= 0.05"
      },
      {
       "walk": "query.mark_variant != 2 && query.modified_move_speed > 0.05"
      }
     ]
    }
   }
  }
 }
}
