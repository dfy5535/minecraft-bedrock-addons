{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "deepvein:ender_alloy_pickaxe",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/entity/tools/ender_alloy_pickaxe",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.deepvein.ender_alloy_pickaxe"
      },
      "animations": {
        "hold_first_person": "animation.deepvein.ender_alloy_pickaxe.hold_first_person",
        "hold_third_person": "animation.deepvein.ender_alloy_pickaxe.hold_third_person",
        "idle": "animation.deepvein.ender_alloy_pickaxe.idle",
        "attack_swing": "animation.deepvein.ender_alloy_pickaxe.attack_swing",
        "skill_cast": "animation.deepvein.ender_alloy_pickaxe.skill_cast"
      },
      "scripts": {
        "animate": [
          {
            "hold_first_person": "c.is_first_person == 1.0"
          },
          {
            "hold_third_person": "c.is_first_person == 0.0"
          },
          "idle",
          {
            "attack_swing": "v.attack_time > 0.0"
          },
          {
            "skill_cast": "q.is_sneaking && v.attack_time > 0.0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}